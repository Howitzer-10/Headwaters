[importlinter]
root_package = headwaters
include_external_packages = True

[importlinter:contract:core-is-a-leaf]
name = Core must not import features, gateway, mcp, daemon, control, installer or cli
type = forbidden
source_modules =
    headwaters.core
forbidden_modules =
    headwaters.features
    headwaters.gateway
    headwaters.mcp
    headwaters.daemon
    headwaters.control
    headwaters.installer
    headwaters.cli

# litellm is reached through importlib in cloud.py (invisible to this linter), so the allowed edge
# may not exist as a static import; tests/test_litellm_guard.py covers the string form.
[importlinter:contract:litellm-only-in-cloud-executor]
name = Only headwaters.core.executor.cloud may import litellm
type = forbidden
source_modules =
    headwaters
forbidden_modules =
    litellm
ignore_imports =
    headwaters.core.executor.cloud -> litellm
unmatched_ignore_imports_alerting = none

[importlinter:contract:mcp-sdk-only-in-mcp]
name = Only headwaters.mcp may import the mcp SDK
type = forbidden
source_modules =
    headwaters.core
    headwaters.cli
    headwaters.control
    headwaters.features
    headwaters.gateway
    headwaters.installer
forbidden_modules =
    mcp

[importlinter:contract:web-framework-only-in-gateway]
name = Only headwaters.gateway may import fastapi, starlette or uvicorn
type = forbidden
source_modules =
    headwaters.core
    headwaters.cli
    headwaters.control
    headwaters.features
    headwaters.installer
    headwaters.mcp
forbidden_modules =
    fastapi
    starlette
    uvicorn

# The daemon is the composition root (D14): it may import everything, nothing may import it. The CLI
# starts it as a child process, so the web framework and the MCP SDK never reach the CLI.
[importlinter:contract:daemon-is-a-root]
name = Nothing imports headwaters.daemon
type = forbidden
source_modules =
    headwaters.core
    headwaters.cli
    headwaters.control
    headwaters.features
    headwaters.gateway
    headwaters.installer
    headwaters.mcp
forbidden_modules =
    headwaters.daemon

# The daemon reaches the SDK and the web framework only through headwaters.mcp and
# headwaters.gateway, so these two count direct imports only.
[importlinter:contract:daemon-no-direct-mcp-sdk]
name = headwaters.daemon does not import the mcp SDK directly
type = forbidden
source_modules =
    headwaters.daemon
forbidden_modules =
    mcp
allow_indirect_imports = True

[importlinter:contract:daemon-no-direct-web-framework]
name = headwaters.daemon does not import fastapi, starlette or uvicorn directly
type = forbidden
source_modules =
    headwaters.daemon
forbidden_modules =
    fastapi
    starlette
    uvicorn
allow_indirect_imports = True
