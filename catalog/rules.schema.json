{
  "$defs": {
    "AttributionRules": {
      "additionalProperties": false,
      "properties": {
        "referer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referer"
        },
        "title": {
          "default": "Headwaters",
          "title": "Title",
          "type": "string"
        }
      },
      "title": "AttributionRules",
      "type": "object"
    },
    "BudgetRules": {
      "additionalProperties": false,
      "properties": {
        "confirm_above_usd": {
          "default": 0.25,
          "minimum": 0,
          "title": "Confirm Above Usd",
          "type": "number"
        },
        "paid_daily_usd": {
          "default": 5.0,
          "minimum": 0,
          "title": "Paid Daily Usd",
          "type": "number"
        },
        "premium_max_usd_per_call": {
          "default": 1.0,
          "minimum": 0,
          "title": "Premium Max Usd Per Call",
          "type": "number"
        }
      },
      "title": "BudgetRules",
      "type": "object"
    },
    "CatalogRules": {
      "additionalProperties": false,
      "properties": {
        "auto_update": {
          "default": true,
          "title": "Auto Update",
          "type": "boolean"
        },
        "disable_when_local": {
          "default": false,
          "title": "Disable When Local",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "CatalogRules",
      "type": "object"
    },
    "ClassifierRules": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "default": "auto_small",
          "title": "Model",
          "type": "string"
        },
        "num_gpu": {
          "default": 0,
          "minimum": 0,
          "title": "Num Gpu",
          "type": "integer"
        },
        "timeout_s": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "title": "ClassifierRules",
      "type": "object"
    },
    "DashboardRules": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "port": {
          "default": 4001,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "DashboardRules",
      "type": "object"
    },
    "EnabledFlag": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "EnabledFlag",
      "type": "object"
    },
    "ExecutorRules": {
      "additionalProperties": false,
      "description": "Timeouts in seconds. The first-token limit is longer for a cold local model, because the\nmodel must be loaded (and the prompt processed) before anything streams.",
      "properties": {
        "cloud_first_token_s": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Cloud First Token S",
          "type": "number"
        },
        "connect_s": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Connect S",
          "type": "number"
        },
        "default_effort": {
          "default": "medium",
          "minLength": 1,
          "title": "Default Effort",
          "type": "string"
        },
        "local_cold_first_token_s": {
          "default": 240,
          "exclusiveMinimum": 0,
          "title": "Local Cold First Token S",
          "type": "number"
        },
        "local_warm_first_token_s": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Local Warm First Token S",
          "type": "number"
        },
        "stream_idle_s": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Stream Idle S",
          "type": "number"
        }
      },
      "title": "ExecutorRules",
      "type": "object"
    },
    "FloorRule": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "minimum": 0,
          "title": "Base",
          "type": "integer"
        },
        "per_complexity": {
          "minimum": 0,
          "title": "Per Complexity",
          "type": "integer"
        }
      },
      "required": [
        "base",
        "per_complexity"
      ],
      "title": "FloorRule",
      "type": "object"
    },
    "FloorsRules": {
      "additionalProperties": false,
      "properties": {
        "agentic_bonus": {
          "default": 15,
          "minimum": 0,
          "title": "Agentic Bonus",
          "type": "integer"
        },
        "chat": {
          "$ref": "#/$defs/FloorRule",
          "default": {
            "base": 50,
            "per_complexity": 3
          }
        },
        "code": {
          "$ref": "#/$defs/FloorRule",
          "default": {
            "base": 70,
            "per_complexity": 5
          }
        },
        "creative": {
          "$ref": "#/$defs/FloorRule",
          "default": {
            "base": 50,
            "per_complexity": 3
          }
        },
        "extract": {
          "$ref": "#/$defs/FloorRule",
          "default": {
            "base": 55,
            "per_complexity": 3
          }
        },
        "high_risk_bonus": {
          "default": 10,
          "minimum": 0,
          "title": "High Risk Bonus",
          "type": "integer"
        },
        "optimistic_margin": {
          "default": 8,
          "minimum": 0,
          "title": "Optimistic Margin",
          "type": "integer"
        },
        "reasoning": {
          "$ref": "#/$defs/FloorRule",
          "default": {
            "base": 70,
            "per_complexity": 6
          }
        },
        "summarize": {
          "$ref": "#/$defs/FloorRule",
          "default": {
            "base": 50,
            "per_complexity": 3
          }
        },
        "verifiable_tasks": {
          "items": {
            "type": "string"
          },
          "title": "Verifiable Tasks",
          "type": "array"
        },
        "vision": {
          "$ref": "#/$defs/FloorRule",
          "default": {
            "base": 60,
            "per_complexity": 4
          }
        }
      },
      "title": "FloorsRules",
      "type": "object"
    },
    "FreeCloudTier": {
      "additionalProperties": false,
      "properties": {
        "opencode_free": {
          "items": {
            "type": "string"
          },
          "title": "Opencode Free",
          "type": "array"
        },
        "ranking": {
          "const": "catalog",
          "default": "catalog",
          "title": "Ranking",
          "type": "string"
        }
      },
      "title": "FreeCloudTier",
      "type": "object"
    },
    "FreeRouterRules": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_complexity": {
          "default": 2,
          "minimum": 0,
          "title": "Max Complexity",
          "type": "integer"
        }
      },
      "title": "FreeRouterRules",
      "type": "object"
    },
    "FusionRules": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "preset": {
          "default": "quality",
          "title": "Preset",
          "type": "string"
        }
      },
      "title": "FusionRules",
      "type": "object"
    },
    "GatewayRules": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "port": {
          "default": 4000,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "GatewayRules",
      "type": "object"
    },
    "HardwareRules": {
      "additionalProperties": false,
      "description": "Local GPU tunables (HDW-151): VRAM reserve, busy check, residency and sysmem thresholds.",
      "properties": {
        "busy_threshold_pct": {
          "default": 50.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Busy Threshold Pct",
          "type": "number"
        },
        "eviction_penalty_per_model": {
          "default": 0.25,
          "minimum": 0,
          "title": "Eviction Penalty Per Model",
          "type": "number"
        },
        "reserve_display_gb": {
          "default": 2.0,
          "minimum": 0,
          "title": "Reserve Display Gb",
          "type": "number"
        },
        "reserve_no_display_gb": {
          "default": 1.0,
          "minimum": 0,
          "title": "Reserve No Display Gb",
          "type": "number"
        },
        "reserve_unknown_gb": {
          "default": 2.5,
          "minimum": 0,
          "title": "Reserve Unknown Gb",
          "type": "number"
        },
        "sysmem_slow_ratio": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Sysmem Slow Ratio",
          "type": "number"
        },
        "sysmem_spill_tolerance": {
          "default": 0.02,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Sysmem Spill Tolerance",
          "type": "number"
        },
        "warm_bonus": {
          "default": 0.15,
          "minimum": 0,
          "title": "Warm Bonus",
          "type": "number"
        }
      },
      "title": "HardwareRules",
      "type": "object"
    },
    "HostsRules": {
      "additionalProperties": false,
      "properties": {
        "subscription": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Subscription",
          "type": "object"
        }
      },
      "title": "HostsRules",
      "type": "object"
    },
    "LocalTier": {
      "additionalProperties": false,
      "properties": {
        "classifier": {
          "$ref": "#/$defs/ClassifierRules"
        },
        "ctx_steps": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Ctx Steps",
          "type": "array"
        },
        "hardware": {
          "$ref": "#/$defs/HardwareRules"
        },
        "host": {
          "default": "http://localhost:11434",
          "title": "Host",
          "type": "string"
        },
        "keep_alive": {
          "default": "30m",
          "title": "Keep Alive",
          "type": "string"
        },
        "keep_warm_model": {
          "default": "auto",
          "title": "Keep Warm Model",
          "type": "string"
        },
        "kv_cache_type": {
          "default": "q8_0",
          "title": "Kv Cache Type",
          "type": "string"
        },
        "offload_weight_factor": {
          "default": 2.0,
          "minimum": 1,
          "title": "Offload Weight Factor",
          "type": "number"
        },
        "on_battery": {
          "default": "prefer_cloud",
          "enum": [
            "prefer_cloud",
            "normal",
            "local_only"
          ],
          "title": "On Battery",
          "type": "string"
        },
        "overhead_gb": {
          "default": 1.0,
          "minimum": 0,
          "title": "Overhead Gb",
          "type": "number"
        },
        "profile": {
          "default": "auto",
          "enum": [
            "auto",
            "laptop_12gb",
            "desktop_16gb",
            "custom"
          ],
          "title": "Profile",
          "type": "string"
        },
        "reserve_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reserve Gb"
        }
      },
      "title": "LocalTier",
      "type": "object"
    },
    "McpRules": {
      "additionalProperties": false,
      "properties": {
        "async_threshold_s": {
          "default": 20,
          "minimum": 0,
          "title": "Async Threshold S",
          "type": "number"
        },
        "job_retention_days": {
          "default": 7,
          "exclusiveMinimum": 0,
          "title": "Job Retention Days",
          "type": "number"
        },
        "roots": {
          "default": "auto",
          "enum": [
            "auto",
            "off"
          ],
          "title": "Roots",
          "type": "string"
        },
        "transport": {
          "const": "stdio",
          "default": "stdio",
          "title": "Transport",
          "type": "string"
        }
      },
      "title": "McpRules",
      "type": "object"
    },
    "ModelOverride": {
      "additionalProperties": false,
      "description": "Per-model user override (applied last). Scores are 0..100, like the floors.",
      "properties": {
        "ctx": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ctx"
        },
        "json_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Ok"
        },
        "scores": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Scores",
          "type": "object"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "local",
                "free_cloud",
                "paid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        },
        "tools_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools Ok"
        }
      },
      "title": "ModelOverride",
      "type": "object"
    },
    "ModelsRules": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "object"
        },
        "openai_compatible": {
          "items": {
            "$ref": "#/$defs/OpenAICompatEndpoint"
          },
          "title": "Openai Compatible",
          "type": "array"
        },
        "opencode_config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opencode Config"
        },
        "overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelOverride"
          },
          "title": "Overrides",
          "type": "object"
        },
        "refresh_ttl_s": {
          "default": 3600,
          "minimum": 60,
          "title": "Refresh Ttl S",
          "type": "number"
        }
      },
      "title": "ModelsRules",
      "type": "object"
    },
    "OpenAICompatEndpoint": {
      "additionalProperties": false,
      "description": "A free OpenAI-compatible endpoint. The key is read from an env var, never stored here.",
      "properties": {
        "api_key_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key Env"
        },
        "base_url": {
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "base_url"
      ],
      "title": "OpenAICompatEndpoint",
      "type": "object"
    },
    "PaidTier": {
      "additionalProperties": false,
      "properties": {
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "use_floor_variant": {
          "default": false,
          "title": "Use Floor Variant",
          "type": "boolean"
        }
      },
      "title": "PaidTier",
      "type": "object"
    },
    "PickerRules": {
      "additionalProperties": false,
      "properties": {
        "show_extras": {
          "default": false,
          "title": "Show Extras",
          "type": "boolean"
        }
      },
      "title": "PickerRules",
      "type": "object"
    },
    "PremiumTier": {
      "additionalProperties": false,
      "properties": {
        "fusion": {
          "$ref": "#/$defs/FusionRules"
        }
      },
      "title": "PremiumTier",
      "type": "object"
    },
    "RouterRules": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "default": 4,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "tier_direction": {
          "default": "cloud_first",
          "enum": [
            "cloud_first",
            "local_first"
          ],
          "title": "Tier Direction",
          "type": "string"
        },
        "tier_order": {
          "default": "interleave",
          "enum": [
            "interleave",
            "descend"
          ],
          "title": "Tier Order",
          "type": "string"
        }
      },
      "title": "RouterRules",
      "type": "object"
    },
    "ScoringRules": {
      "additionalProperties": false,
      "description": "Policy engine weights (HDW-113). Scores are on the same 0..100 scale as the floors.",
      "properties": {
        "assumed_output_tokens": {
          "default": 1000,
          "minimum": 0,
          "title": "Assumed Output Tokens",
          "type": "integer"
        },
        "complexity_penalty_per_level": {
          "default": 10.0,
          "minimum": 0,
          "title": "Complexity Penalty Per Level",
          "type": "number"
        },
        "ctx_headroom": {
          "default": 1.2,
          "minimum": 1,
          "title": "Ctx Headroom",
          "type": "number"
        },
        "gpu_busy_local_penalty": {
          "default": 15.0,
          "minimum": 0,
          "title": "Gpu Busy Local Penalty",
          "type": "number"
        },
        "latency_max_penalty": {
          "default": 20.0,
          "minimum": 0,
          "title": "Latency Max Penalty",
          "type": "number"
        },
        "latency_ref_tps": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "title": "Latency Ref Tps",
          "type": "number"
        },
        "latency_weight": {
          "default": 5.0,
          "minimum": 0,
          "title": "Latency Weight",
          "type": "number"
        },
        "offload_penalty": {
          "default": 30.0,
          "minimum": 0,
          "title": "Offload Penalty",
          "type": "number"
        },
        "on_battery_local_penalty": {
          "default": 20.0,
          "minimum": 0,
          "title": "On Battery Local Penalty",
          "type": "number"
        },
        "residency_scale": {
          "default": 100.0,
          "minimum": 0,
          "title": "Residency Scale",
          "type": "number"
        },
        "session_bonus": {
          "default": 5.0,
          "minimum": 0,
          "title": "Session Bonus",
          "type": "number"
        },
        "soft_quota_penalty": {
          "default": 10.0,
          "minimum": 0,
          "title": "Soft Quota Penalty",
          "type": "number"
        },
        "strategies": {
          "$ref": "#/$defs/StrategiesRules"
        }
      },
      "title": "ScoringRules",
      "type": "object"
    },
    "SecretsRules": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "local",
          "enum": [
            "local",
            "refuse",
            "off"
          ],
          "title": "Action",
          "type": "string"
        },
        "scan_base64_max_chars": {
          "default": 16384,
          "minimum": 64,
          "title": "Scan Base64 Max Chars",
          "type": "integer"
        },
        "scan_base64_min_chars": {
          "default": 24,
          "minimum": 8,
          "title": "Scan Base64 Min Chars",
          "type": "integer"
        },
        "scan_budget_ms": {
          "default": 2000,
          "minimum": 50,
          "title": "Scan Budget Ms",
          "type": "integer"
        },
        "scan_decode": {
          "default": true,
          "title": "Scan Decode",
          "type": "boolean"
        },
        "scan_join": {
          "default": true,
          "title": "Scan Join",
          "type": "boolean"
        },
        "scan_join_span": {
          "default": 2,
          "maximum": 8,
          "minimum": 1,
          "title": "Scan Join Span",
          "type": "integer"
        },
        "scan_join_window_chars": {
          "default": 2048,
          "minimum": 64,
          "title": "Scan Join Window Chars",
          "type": "integer"
        },
        "scan_max_candidates": {
          "default": 256,
          "minimum": 1,
          "title": "Scan Max Candidates",
          "type": "integer"
        },
        "scan_max_decoded_bytes": {
          "default": 1048576,
          "minimum": 1024,
          "title": "Scan Max Decoded Bytes",
          "type": "integer"
        },
        "scan_percent_max_chars": {
          "default": 262144,
          "minimum": 64,
          "title": "Scan Percent Max Chars",
          "type": "integer"
        }
      },
      "title": "SecretsRules",
      "type": "object"
    },
    "StrategiesRules": {
      "additionalProperties": false,
      "properties": {
        "cost_saver": {
          "$ref": "#/$defs/StrategyWeights",
          "default": {
            "cost_weight": 400.0,
            "evict_mult": 1.0,
            "latency_mult": 1.0,
            "primary_bonus": 0.0,
            "warm_mult": 1.0
          }
        },
        "primary_first": {
          "$ref": "#/$defs/StrategyWeights",
          "default": {
            "cost_weight": 0.0,
            "evict_mult": 1.0,
            "latency_mult": 1.0,
            "primary_bonus": 30.0,
            "warm_mult": 1.0
          }
        },
        "quality_first": {
          "$ref": "#/$defs/StrategyWeights",
          "default": {
            "cost_weight": 40.0,
            "evict_mult": 0.5,
            "latency_mult": 0.5,
            "primary_bonus": 0.0,
            "warm_mult": 0.5
          }
        }
      },
      "title": "StrategiesRules",
      "type": "object"
    },
    "StrategyWeights": {
      "additionalProperties": false,
      "description": "How one strategy adjusts the score terms (HDW-113). All values are first-draft.",
      "properties": {
        "cost_weight": {
          "minimum": 0,
          "title": "Cost Weight",
          "type": "number"
        },
        "evict_mult": {
          "default": 1.0,
          "minimum": 0,
